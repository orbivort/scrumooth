{
  "name": "@scrumooth/shared",
  "version": "3.0.2",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Shared types and utilities for Scrumooth - Self-hosted Scrum tool, faithful to the Scrum Guide",
  "keywords": [
    "scrum",
    "scrum-tool",
    "scrum-guide",
    "self-hosted",
    "typescript",
    "shared"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/orbivort/scrumooth.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/orbivort/scrumooth/issues"
  },
  "homepage": "https://github.com/orbivort/scrumooth#readme",
  "author": "Orbivort",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./constants": {
      "import": "./dist/constants/index.js",
      "types": "./dist/constants/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    }
  },
  "dependencies": {
    "date-fns": "catalog:"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.19.0"
  }
}
