# ===========================================
# Scrumooth Frontend - Demo Mode
# ===========================================
# Backend-free demo build: mock mode is served by the MSW handler registry, so the
# whole Scrum lifecycle can be explored without a database or a server.
#
#   pnpm run build:demo     # build it
#   pnpm run preview:demo   # serve the build locally
#
# This file is committed on purpose. It contains no secrets: Vite only exposes
# VITE_-prefixed values and they end up in the public bundle anyway. It is the
# ONLY supported way to ship a build with mocks enabled - a production-mode build
# refuses to run with VITE_USE_MOCK_API=true (see the guard in vite.config.ts).
# ===========================================

# GitHub Pages serves the demo from a sub-path. Override with '/' for a
# root-level deployment.
VITE_BASE_PATH=/scrumooth/

# Same-origin path: the service worker intercepts the app's own traffic, so there
# is no cross-origin request and no CORS preflight to satisfy.
VITE_API_URL=/api/v1

VITE_USE_MOCK_API=true

# Simulated latency per mocked response. Raise it to make loading states easier to
# observe while developing; 0 disables it.
VITE_MOCK_LATENCY_MS=60

VITE_LOG_LEVEL=info
VITE_BACKLOG_ITEM_LIMIT=100
VITE_BACKLOG_MAX_ITEMS_PER_GOAL=200
