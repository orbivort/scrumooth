{
  "name": "@scrumooth/frontend",
  "version": "3.0.2",
  "private": true,
  "license": "Apache-2.0",
  "description": "Frontend UI for Scrumooth - Self-hosted Scrum tool, faithful to the Scrum Guide",
  "keywords": [
    "scrum",
    "scrum-tool",
    "scrum-guide",
    "self-hosted",
    "typescript",
    "react",
    "vite"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/orbivort/scrumooth.git",
    "directory": "packages/frontend"
  },
  "bugs": {
    "url": "https://github.com/orbivort/scrumooth/issues"
  },
  "homepage": "https://github.com/orbivort/scrumooth#readme",
  "author": "Orbivort",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "cross-env NODE_ENV=test vite --mode test",
    "build": "tsc -b && vite build",
    "build:analyze": "tsc -b && vite build --mode analyze",
    "preview": "vite preview",
    "serve": "vite preview --host",
    "clean": "rimraf dist coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "test:verbose": "cross-env NODE_ENV=test vitest run --verbose",
    "test:ci": "cross-env NODE_ENV=test vitest run --coverage --reporter=json --reporter=html",
    "test:changed": "cross-env NODE_ENV=test vitest run --changed",
    "test:ui": "cross-env NODE_ENV=test vitest --ui",
    "test:e2e": "cross-env E2E_BROWSERS=desktop playwright test",
    "test:e2e:all": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:desktop": "cross-env E2E_BROWSERS=desktop playwright test",
    "test:e2e:mobile": "cross-env E2E_BROWSERS=mobile playwright test",
    "test:e2e:chromium": "cross-env E2E_BROWSERS=chromium playwright test",
    "test:e2e:firefox": "cross-env E2E_BROWSERS=firefox playwright test",
    "test:e2e:webkit": "cross-env E2E_BROWSERS=webkit playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:ci": "cross-env E2E_BROWSERS=desktop playwright test",
    "generate:icon-types": "tsx ../../scripts/utility/generate-icon-types.ts",
    "generate:icon-types:watch": "tsx ../../scripts/utility/generate-icon-types.ts --watch",
    "build:github-pages": "tsc -b && vite build --mode production",
    "preview:github-pages": "vite preview --mode production",
    "serve:github-pages": "vite preview --mode production --host",
    "i18n:extract:ast": "i18next-cli extract --config i18next.config.ts"
  },
  "dependencies": {
    "@scrumooth/shared": "workspace:*",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.2",
    "axios": "^1.18.0",
    "chart.js": "^4.5.1",
    "date-fns": "catalog:",
    "i18next": "catalog:",
    "i18next-browser-languagedetector": "^8.0.0",
    "i18next-http-backend": "^3.0.0",
    "intl-pluralrules": "catalog:",
    "react": "^19.2.7",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-i18next": "^15.7.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "catalog:",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "catalog:",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react": "catalog:",
    "globals": "catalog:",
    "i18next-cli": "^1.67.0",
    "jsdom": "^29.1.1",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "rollup-plugin-visualizer": "^7.0.1",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vi-axe": "^1.0.0",
    "vite": "^8.0.16",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.19.0"
  }
}
