  EARLY_RELEASE
}

enum IntegrationTestResult {
  PENDING
  PASSED
  FAILED
}

enum ScrumValue {
  COMMITMENT
  FOCUS
  OPENNESS
  RESPECT
  COURAGE
}

enum HealthCheckStatus {
  OPEN
  CLOSED
}

enum FeedbackCategory {
  POSITIVE
  NEGATIVE
  SUGGESTION
  QUESTION
}

enum ActionItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RetrospectiveStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
}

enum TimeboxStatus {
