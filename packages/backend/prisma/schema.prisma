  PRODUCT_OWNER
  SCRUM_MASTER
  DEVELOPERS
}

enum ItemStatus {
  NEW
  REFINED
  READY
  IN_PROGRESS
  DONE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum SprintStatus {
  DRAFT
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ImpedimentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ProductGoalStatus {
  NEW
  ACTIVE
  COMPLETED
  ABANDONED
}

enum MoSCoWPriority {
  MUST_HAVE
  SHOULD_HAVE
  COULD_HAVE
  WONT_HAVE
}

