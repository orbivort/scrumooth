enum NotificationType {
  TEAM_INVITATION
  TEAM_REMOVAL
  TASK_ASSIGNMENT
  IMPEDIMENT_ASSIGNMENT
  DAILY_SCRUM_SIGNAL
  TEAM_CREATED
  TEAM_UPDATED
  TEAM_DELETED
  DIRECT_MESSAGE
  ACCOUNT_DELETION_SCHEDULED
  ACCOUNT_DELETION_CANCELLED
}

enum EmailType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
  WELCOME
  PASSWORD_CHANGE
  ACCOUNT_DELETION
  TEAM_INVITATION
  NOTIFICATION
}

enum EmailStatus {
  PENDING
