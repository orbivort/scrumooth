{
  "name": "@scrumooth/backend",
  "version": "3.0.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Backend API for Scrumooth - Self-hosted Scrum tool, faithful to the Scrum Guide",
  "keywords": [
    "scrum",
    "scrum-tool",
    "scrum-guide",
    "self-hosted",
    "typescript",
    "nodejs",
    "express",
    "prisma"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/orbivort/scrumooth.git",
    "directory": "packages/backend"
  },
  "bugs": {
    "url": "https://github.com/orbivort/scrumooth/issues"
  },
  "homepage": "https://github.com/orbivort/scrumooth#readme",
  "author": "Orbivort",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:test": "cross-env NODE_ENV=test tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rimraf dist coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "cross-env NODE_ENV=test vitest run src/__tests__/unit",
    "test:watch": "vitest",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage",
    "test:unit": "cross-env NODE_ENV=test vitest run src/__tests__/unit",
    "test:unit:coverage": "cross-env NODE_ENV=test vitest run src/__tests__/unit --coverage",
    "test:integration": "cross-env NODE_ENV=test vitest run src/__tests__/integration",
    "test:integration:coverage": "cross-env NODE_ENV=test vitest run src/__tests__/integration --coverage",
    "test:e2e": "cross-env NODE_ENV=test vitest run src/__tests__/e2e",
    "test:e2e:coverage": "cross-env NODE_ENV=test vitest run src/__tests__/e2e --coverage",
    "test:all": "cross-env NODE_ENV=test vitest run",
    "test:ci": "cross-env NODE_ENV=test vitest run --coverage --reporter=json --reporter=html",
    "test:changed": "vitest run --changed",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:test": "cross-env NODE_ENV=test prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:validate": "prisma validate",
    "loadtest:data": "tsx scripts/generate-load-test-data.ts",
    "loadtest:data:clear": "tsx scripts/generate-load-test-data.ts --clear"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@scrumooth/shared": "workspace:*",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "i18next": "catalog:",
    "intl-pluralrules": "catalog:",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.1.1",
    "resolve-accept-language": "^3.2.2",
    "sanitize-html": "^2.17.5",
    "uuid": "^14.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@faker-js/faker": "^10.4.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "catalog:",
    "cross-env": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prisma": "^7.9.1",
    "rimraf": "catalog:",
    "supertest": "^7.2.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.19.0"
  }
}
